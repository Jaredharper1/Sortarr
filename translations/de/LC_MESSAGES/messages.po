msgid ""
"Use field:value for wildcards and comparisons. Numeric fields treat "
"field:value as >= (use = for exact). gbperhour/totalsize with integer values"
" use a whole-number bucket (e.g., gbperhour:1 = 1.0-1.99). Bare tokens (like"
" aac) search across row text; use any:value for explicit global search. "
"Examples: dateadded:2024 year:2024 status:continuing monitored:true "
"qualityprofile:HD-1080p tags:kids releasegroup:ntb studio:pixar "
"seriestype:anime originallanguage:eng genres:drama duplicate:true "
"missing:true cutoff:true airing:true playcount>=5 neverwatched:true "
"mismatch:true dayssincewatched>=365 watchtime>=10 contenthours>=10 any:aac "
"Fields: title, year, titleslug, tmdbid, dateadded, path, rootfolder, "
"instance, duplicate, any, status, monitored, qualityprofile, tags, "
"releasegroup, studio, seriestype, originallanguage, genres, lastaired, "
"hasfile, isavailable, incinemas, lastsearchtime, edition, customformats, "
"customformatscore, qualitycutoffnotmet, languages, videoquality, videocodec,"
